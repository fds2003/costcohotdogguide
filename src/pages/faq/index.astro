---
import BaseLayout from '../../layouts/BaseLayout.astro';

const faqs = [
  {
    category: "Dietary Restrictions",
    questions: [
      { q: "Are Costco hot dogs gluten free?", href: "/hot-dog/gluten-free/", keyword: "gluten free" },
      { q: "Are Costco hot dogs dairy free?", href: "/faq/dairy-free-buns/", keyword: "dairy free" },
      { q: "Are Costco hot dogs vegan?", href: "/hot-dog/vegan/", keyword: "vegan" },
      { q: "Are Costco hot dogs soy free?", href: "/faq/soy-free/", keyword: "soy free" },
    ]
  },
  {
    category: "Ingredients",
    questions: [
      { q: "Does Costco hot dog have pork?", href: "/ingredients/beef-or-pork/", keyword: "pork" },
      { q: "Are Costco hot dogs all beef?", href: "/ingredients/brand/", keyword: "all beef" },
      { q: "Do Costco hot dogs have MSG?", href: "/faq/msg/", keyword: "msg" },
      { q: "Do Costco hot dogs have nitrates?", href: "/faq/nitrates/", keyword: "nitrates" },
    ]
  },
  {
    category: "Religious & Cultural",
    questions: [
      { q: "Is Costco hot dog kosher?", href: "/faq/kosher/", keyword: "kosher" },
      { q: "Are Costco hot dogs halal?", href: "/faq/halal/", keyword: "halal" },
    ]
  },
  {
    category: "Other Common Questions",
    questions: [
      { q: "How big is a Costco hot dog?", href: "/faq/how-big/", keyword: "size" },
      { q: "Can you buy a Costco hot dog without a membership?", href: "/faq/without-membership/", keyword: "membership" },
      { q: "Does the Costco hot dog come with a drink?", href: "/faq/with-drink/", keyword: "drink" },
      { q: "Is the Costco hot dog beef or pork?", href: "/ingredients/beef-or-pork/", keyword: "beef or pork" },
    ]
  },
];
---

<BaseLayout
  title="Costco Hot Dog FAQ — All Your Questions Answered (2026)"
  description="Find answers to all your Costco hot dog questions: gluten free, dairy free, kosher, halal, ingredients, nitrates, and more. Updated July 2026."
  type="website"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Costco Hot Dog FAQ</h1>
    <p class="text-lg text-gray-600 mb-8">Every question about the famous $1.50 Costco hot dog — answered in one place. From dietary restrictions to ingredients, pricing, and cooking tips.</p>

    {faqs.map(category => (
      <section class="mb-10">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">{category.category}</h2>
        <div class="space-y-4">
          {category.questions.map(faq => (
            <details class="group rounded-lg border border-gray-200 bg-white p-5 shadow-sm hover:shadow-md transition">
              <summary class="text-lg font-semibold text-gray-900 cursor-pointer list-none flex justify-between items-center">
                {faq.q}
                <span class="text-red-700 group-open:rotate-180 transition-transform duration-200">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="mt-3 pt-3 border-t border-gray-100">
                <a href={faq.href} class="text-red-700 font-medium hover:underline">
                  Read full answer about "{faq.keyword}" →
                </a>
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}

    <div class="bg-red-50 border border-red-200 rounded-xl p-6 mt-8">
      <h2 class="text-xl font-bold text-gray-900 mb-3">Quick Facts</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div>
          <div class="text-2xl font-bold text-red-600">$1.50</div>
          <div class="text-sm text-gray-600">Price since 1985</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-red-600">570</div>
          <div class="text-sm text-gray-600">Calories with bun</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-red-600">100%</div>
          <div class="text-sm text-gray-600">All-Beef</div>
        </div>
        <div>
          <div class="text-2xl font-bold text-red-600">41yr</div>
          <div class="text-sm text-gray-600">Same price</div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
